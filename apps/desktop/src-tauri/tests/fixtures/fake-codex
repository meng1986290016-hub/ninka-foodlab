#!/bin/sh

if [ "$1" = "--version" ]; then
  printf '%s\n' 'codex-cli 9.9.9'
  exit 0
fi

if [ "$1" = "login" ] && [ "$2" = "status" ]; then
  printf '%s\n' 'Logged in using test account'
  exit 0
fi

if [ "$1" = "debug" ] && [ "$2" = "models" ]; then
  printf '%s\n' '{"models":[{"slug":"gpt-5.6-sol","display_name":"GPT-5.6-Sol","visibility":"list","priority":1},{"slug":"hidden-model","display_name":"Hidden model","visibility":"hide","priority":0}]}'
  exit 0
fi

expect_mcp=0
has_mcp_command=0
has_mcp_token=0
has_mcp_approval=0
expect_image_boundary=0
has_image=0
separator_after_image=0
prompt_after_separator=0
after_separator=0
failed_mcp=0
provider_probe=0
for argument in "$@"; do
  case "$argument" in
    *__HANG__*) exec sleep 30 ;;
    *UNSELECTED_SECRET*) printf '%s\n' 'unselected attachment leaked' >&2; exit 90 ;;
    *__EXPECT_MCP__*) expect_mcp=1 ;;
    *__FAILED_MCP__*) failed_mcp=1 ;;
    *'仅返回 JSON'*) provider_probe=1 ;;
    *__EXPECT_IMAGE_PROMPT_BOUNDARY__*)
      expect_image_boundary=1
      if [ "$after_separator" = "1" ]; then prompt_after_separator=1; fi
      ;;
    -i) has_image=1 ;;
    --)
      after_separator=1
      if [ "$has_image" = "1" ]; then separator_after_image=1; fi
      ;;
    mcp_servers.food_rd.command=*) has_mcp_command=1 ;;
    mcp_servers.food_rd.default_tools_approval_mode=*approve*) has_mcp_approval=1 ;;
    *FOOD_RD_MCP_TOKEN*) has_mcp_token=1 ;;
  esac
done
if [ "$expect_mcp" = "1" ] && { [ "$has_mcp_command" != "1" ] || [ "$has_mcp_token" != "1" ] || [ "$has_mcp_approval" != "1" ]; }; then
  printf '%s\n' 'missing task-scoped MCP config' >&2
  exit 91
fi
if [ "$expect_image_boundary" = "1" ] && { [ "$has_image" != "1" ] || [ "$separator_after_image" != "1" ] || [ "$prompt_after_separator" != "1" ]; }; then
  printf '%s\n' 'image prompt boundary missing' >&2
  exit 92
fi

if [ "$provider_probe" = "1" ]; then
  printf '%s\n' '{"type":"item.completed","item":{"id":"message-probe","type":"agent_message","text":"{\"finalResponse\":{\"ok\":true},\"toolCalls\":[]}"}}'
  printf '%s\n' '{"type":"turn.completed","usage":{"input_tokens":2,"output_tokens":1}}'
  exit 0
fi

if [ "$failed_mcp" = "1" ]; then
  printf '%s\n' '{"type":"item.completed","item":{"id":"call-cancelled","type":"mcp_tool_call","server":"food_rd","tool":"read_task_attachments","arguments":{},"result":null,"error":{"message":"user cancelled MCP tool call"},"status":"failed"}}'
  printf '%s\n' '{"type":"item.completed","item":{"id":"message-failed","type":"agent_message","text":"工具被取消"}}'
  printf '%s\n' '{"type":"turn.completed","usage":{"input_tokens":10,"output_tokens":5}}'
  exit 0
fi

printf '%s\n' '{"type":"item.completed","item":{"id":"message-1","type":"agent_message","text":"{\"finalResponse\":{\"items\":[]},\"toolCalls\":[{\"id\":\"call-codex\",\"name\":\"create_ingredient_import_draft\",\"arguments\":\"{\\\"materialName\\\":\\\"脱脂乳粉\\\"}\"}]}"}}'
printf '%s\n' '{"type":"turn.completed","usage":{"input_tokens":10,"output_tokens":5}}'

#!/bin/sh

if [ "$1" = "--version" ]; then
  printf '%s\n' '2.1.0 (Claude Code)'
  exit 0
fi

if [ "$1" = "auth" ] && [ "$2" = "status" ]; then
  printf '%s\n' '{"loggedIn":true,"authMethod":"test"}'
  exit 0
fi

expect_mcp=0
mcp_config_path=
previous=
has_allowed_tools=0
failed_mcp=0
provider_probe=0
for argument in "$@"; do
  if [ "$previous" = "--mcp-config" ]; then
    mcp_config_path=$argument
  fi
  if [ "$previous" = "--allowedTools" ] && [ "$argument" = "mcp__food_rd__*" ]; then
    has_allowed_tools=1
  fi
  case "$argument" in
    *__HANG__*) exec sleep 30 ;;
    *UNSELECTED_SECRET*) printf '%s\n' 'unselected attachment leaked' >&2; exit 90 ;;
    *__EXPECT_MCP__*) expect_mcp=1 ;;
    *__FAILED_MCP__*) failed_mcp=1 ;;
    *'仅返回 JSON'*) provider_probe=1 ;;
  esac
  previous=$argument
done
if [ "$expect_mcp" = "1" ]; then
  if [ "$has_allowed_tools" != "1" ] || [ -z "$mcp_config_path" ] || ! grep -q '"food_rd"' "$mcp_config_path" || ! grep -q 'FOOD_RD_MCP_TOKEN' "$mcp_config_path"; then
    printf '%s\n' 'missing task-scoped MCP config' >&2
    exit 91
  fi
fi

if [ "$provider_probe" = "1" ]; then
  printf '%s\n' '{"type":"result","subtype":"success","result":"{\"finalResponse\":{\"ok\":true},\"toolCalls\":[]}","structured_output":{"finalResponse":{"ok":true},"toolCalls":[]},"usage":{"input_tokens":2,"output_tokens":1}}'
  exit 0
fi

if [ "$failed_mcp" = "1" ]; then
  printf '%s\n' '{"type":"assistant","message":{"content":[{"type":"tool_use","id":"call-claude-failed","name":"mcp__food_rd__read_task_attachments","input":{}}]}}'
  printf '%s\n' '{"type":"user","message":{"content":[{"type":"tool_result","tool_use_id":"call-claude-failed","content":"permission denied","is_error":true}]}}'
  printf '%s\n' '{"type":"result","subtype":"success","is_error":false,"result":"工具被拒绝","structured_output":{"items":[]},"usage":{"input_tokens":10,"output_tokens":5}}'
  exit 0
fi

printf '%s\n' '{"type":"stream_event","event":{"type":"content_block_delta","delta":{"type":"text_delta","text":"{\"finalResponse\":{\"items\":[]},\"toolCalls\":[{\"id\":\"call-claude\",\"name\":\"create_ingredient_import_draft\",\"arguments\":\"{\\\"materialName\\\":\\\"脱脂乳粉\\\"}\"}]}"}}}'
printf '%s\n' '{"type":"result","subtype":"success","result":"{\"finalResponse\":{\"items\":[]},\"toolCalls\":[{\"id\":\"call-claude\",\"name\":\"create_ingredient_import_draft\",\"arguments\":\"{\\\"materialName\\\":\\\"脱脂乳粉\\\"}\"}]}","structured_output":{"finalResponse":{"items":[]},"toolCalls":[{"id":"call-claude","name":"create_ingredient_import_draft","arguments":"{\"materialName\":\"脱脂乳粉\"}"}]},"usage":{"input_tokens":10,"output_tokens":5}}'

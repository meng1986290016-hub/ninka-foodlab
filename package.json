{
  "name": "food-rd-studio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "brand:generate": "PYTHONPATH=scripts/branding .venv-branding/bin/python scripts/branding/generate_all.py",
    "brand:verify": "PYTHONPATH=scripts/branding .venv-branding/bin/python scripts/branding/verify_assets.py",
    "build": "pnpm -r --if-present build",
    "dev:desktop": "pnpm --filter @food-rd/desktop dev",
    "tauri:build": "pnpm --filter @food-rd/desktop tauri:build",
    "tauri:dev": "pnpm --filter @food-rd/desktop tauri:dev",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test"
  }
}

{
  "name": "food-rd-studio",
  "version": "0.2.1",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "agent-runtime:prepare": "npm --prefix apps/desktop run agent-runtime:prepare",
    "agent-runtime:verify": "node scripts/release/verify-agent-runtime.mjs",
    "brand:generate": "PYTHONPATH=scripts/branding .venv-branding/bin/python scripts/branding/generate_all.py",
    "brand:verify": "PYTHONPATH=scripts/branding .venv-branding/bin/python scripts/branding/verify_assets.py",
    "build": "pnpm -r --if-present build",
    "desktop:artifacts": "node scripts/release/collect-desktop-artifacts.mjs",
    "desktop:bundle:macos": "pnpm --filter @food-rd/desktop tauri build --bundles app --ci",
    "desktop:bundle:macos:dmg": "node scripts/release/create-simple-dmg.mjs",
    "desktop:bundle:windows": "pnpm --filter @food-rd/desktop tauri build --bundles nsis --no-sign --ci",
    "dev:desktop": "pnpm --filter @food-rd/desktop dev",
    "licenses:generate": "node scripts/release/generate-third-party-license-inventory.mjs",
    "open-source:verify": "node scripts/release/verify-open-source-readiness.mjs",
    "promo:capture": "pnpm --filter @food-rd/promo-video capture",
    "promo:2k": "pnpm --filter @food-rd/promo-video render:2k",
    "promo:keyframes": "pnpm --filter @food-rd/promo-video render:keyframes",
    "promo:launch-animatic": "pnpm --filter @food-rd/promo-video render:launch-animatic",
    "promo:launch-animatic:keyframes": "pnpm --filter @food-rd/promo-video render:launch-animatic:keyframes",
    "promo:launch-animatic:verify": "pnpm --filter @food-rd/promo-video verify:launch-animatic",
    "promo:landscape": "pnpm --filter @food-rd/promo-video render:landscape",
    "promo:landscape:keyframes": "pnpm --filter @food-rd/promo-video render:landscape:keyframes",
    "promo:motion-test": "pnpm --filter @food-rd/promo-video render:motion-test",
    "promo:motion-test:keyframes": "pnpm --filter @food-rd/promo-video render:motion-test:keyframes",
    "promo:motion-test:verify": "pnpm --filter @food-rd/promo-video verify:motion-test",
    "promo:cover": "pnpm --filter @food-rd/promo-video render:cover",
    "promo:preview": "pnpm --filter @food-rd/promo-video render:preview",
    "promo:reference-style-test": "pnpm --filter @food-rd/promo-video render:reference-style-test",
    "promo:reference-style-test:audio": "pnpm --filter @food-rd/promo-video audio:reference-style-test",
    "promo:reference-style-test:keyframes": "pnpm --filter @food-rd/promo-video render:reference-style-test:keyframes",
    "promo:ingredient-camera-test-02": "pnpm --filter @food-rd/promo-video render:ingredient-camera-test-02",
    "promo:ingredient-camera-test-02:keyframes": "pnpm --filter @food-rd/promo-video render:ingredient-camera-test-02:keyframes",
    "promo:ingredient-camera-test-02:verify": "pnpm --filter @food-rd/promo-video verify:ingredient-camera-test-02",
    "promo:launch-camera-v03": "pnpm --filter @food-rd/promo-video render:launch-camera-v03",
    "promo:launch-camera-v03:keyframes": "pnpm --filter @food-rd/promo-video render:launch-camera-v03:keyframes",
    "promo:launch-camera-v03:verify": "pnpm --filter @food-rd/promo-video verify:launch-camera-v03",
    "promo:segment-01-opening": "pnpm --filter @food-rd/promo-video render:segment-01-opening",
    "promo:segment-01-opening:keyframes": "pnpm --filter @food-rd/promo-video render:segment-01-opening:keyframes",
    "promo:segment-01-opening:verify": "pnpm --filter @food-rd/promo-video verify:segment-01-opening",
    "promo:segment-02-product-reveal": "pnpm --filter @food-rd/promo-video render:segment-02-product-reveal",
    "promo:segment-02-product-reveal:keyframes": "pnpm --filter @food-rd/promo-video render:segment-02-product-reveal:keyframes",
    "promo:segment-02-product-reveal:verify": "pnpm --filter @food-rd/promo-video verify:segment-02-product-reveal",
    "promo:combined-first-three": "pnpm --filter @food-rd/promo-video render:combined-first-three",
    "promo:combined-first-three:keyframes": "pnpm --filter @food-rd/promo-video render:combined-first-three:keyframes",
    "promo:combined-first-three:verify": "pnpm --filter @food-rd/promo-video verify:combined-first-three",
    "promo:segment-04-workbench-recalculation": "pnpm --filter @food-rd/promo-video render:segment-04-workbench-recalculation",
    "promo:segment-04-workbench-recalculation:keyframes": "pnpm --filter @food-rd/promo-video render:segment-04-workbench-recalculation:keyframes",
    "promo:segment-04-workbench-recalculation:verify": "pnpm --filter @food-rd/promo-video verify:segment-04-workbench-recalculation",
    "promo:segment-04-workbench-recalculation:v02": "pnpm --filter @food-rd/promo-video render:segment-04-workbench-recalculation:v02",
    "promo:segment-04-workbench-recalculation:v02:keyframes": "pnpm --filter @food-rd/promo-video render:segment-04-workbench-recalculation:v02:keyframes",
    "promo:segment-04-workbench-recalculation:v02:verify": "pnpm --filter @food-rd/promo-video verify:segment-04-workbench-recalculation:v02",
    "promo:reference-style-test:verify": "pnpm --filter @food-rd/promo-video verify:reference-style-test",
    "promo:render": "pnpm --filter @food-rd/promo-video render:final",
    "promo:silent": "pnpm --filter @food-rd/promo-video render:silent",
    "promo:studio": "pnpm --filter @food-rd/promo-video studio",
    "promo:verify": "pnpm --filter @food-rd/promo-video verify",
    "tauri:build": "npm --prefix apps/desktop run tauri:build",
    "tauri:dev": "npm --prefix apps/desktop run tauri:dev",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test"
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "食研工作台",
  "version": "0.1.0",
  "identifier": "com.foodrd.studio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "食研工作台",
        "width": 1280,
        "height": 800,
        "minWidth": 620,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Ninka FoodLab 主窗口的基础权限，不包含 shell 与任意文件系统访问。",
  "windows": ["main", "foodlab-agent"],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-set-focus",
    "core:window:allow-close",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
